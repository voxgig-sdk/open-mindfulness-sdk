  name: "BasicGlossaryFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "glossary_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "glossary_ref01",
