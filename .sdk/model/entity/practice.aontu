# Entity: practice

main: kit: entity: practice: {

  alias: field: {}

  fields: {
    audio_url: {
      h: "Audio Url"
      n: "audio_url"
      r: false
      sh: "Direct link to the MP3 file (Cloudflare R2)."
      t: "`$STRING`"
    }
    canonical_url: {
      h: "Canonical Url"
      n: "canonical_url"
      r: false
      t: "`$STRING`"
    }
    category: {
      h: "Category"
      n: "category"
      r: false
      t: "`$STRING`"
    }
    excerpt: {
      h: "Excerpt"
      n: "excerpt"
      r: false
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "The stable public track ID (same value as `track_id`), in the form \"SL-*\"."
      t: "`$STRING`"
    }
    read_time_minutes: {
      h: "Read Time Minutes"
      n: "read_time_minutes"
      r: false
      t: "`$INTEGER`"
    }
    related_practices: {
      h: "Related Practices"
      n: "related_practices"
      r: false
      sh: "Free practices only — a paid track can never appear here even as a reference."
      t: "`$ARRAY`"
    }
    slug: {
      h: "Slug"
      n: "slug"
      r: false
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
      r: false
      t: "`$STRING`"
    }
    track_id: {
      h: "Track Id"
      n: "track_id"
      r: false
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: false
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "practice"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/practices"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "category"
                or: "category"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 20
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 0
                k: "query"
                n: "offset"
                or: "offset"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/v1/practices"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "practices"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/practices/{slug}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "slug"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/practices/{slug}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              slug: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "practices"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
