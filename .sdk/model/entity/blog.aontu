  }

  name: "blog"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/blog"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 20
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 0
                k: "query"
                n: "offset"
                or: "offset"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "q"
                or: "q"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "tag"
                or: "tag"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/blog"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "blog"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/blog/{slug}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "slug"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/blog/{slug}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              slug: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "blog"
            }
            {
              var: "id"
